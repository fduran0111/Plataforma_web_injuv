# Copia este archivo a `.env` en la raíz del proyecto y rellena los valores.
# Nunca subas `.env` al repositorio.

# --- Base de datos (PostgreSQL existente de INJUV) ---
# Opción A: URL completa (local, Neon, Render…)
DATABASE_URL=
# Opción B: componentes sueltos (si no usas DATABASE_URL)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=INJUV
# POSTGRES_POOL_SIZE=5
# POSTGRES_MAX_OVERFLOW=10

# --- Auth JWT (obligatorio, mínimo 32 caracteres) ---
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS y URL del frontend ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_VERCEL_APP_REGEX=1
FRONTEND_URL=http://localhost:3000

# --- Correo (Flask-Mail en el backend legado; se reutilizará en la API nueva) ---
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=
